Language: Cpp
BasedOnStyle: LLVM
UseTab: Never           # 使用空格而不是制表符
IndentWidth: 4          # 缩进宽度为4个空格
TabWidth: 4             # Tab长度
ColumnLimit: 100         # 单行的长度不超过86字符
PointerAlignment: Left  # &和*靠左显示
AccessModifierOffset: 0  #控制访问修饰符(public, private, protected的位置)


BraceWrapping:          # 大括号换行规则
  AfterClass: false
  AfterControlStatement: false
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterObjCDeclaration: false
  AfterStruct: false
  AfterUnion: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
